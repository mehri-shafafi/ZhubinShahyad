@page "/products/create"
@using BlazorApp.Dtos.Products
@using BlazorApp.Dtos.Products.Brands
@using BlazorApp.Dtos.Products.Categories
@inject HttpClient Http
@inject NavigationManager Navigation

<h3 class="mb-3">Create Product</h3>

<EditForm Model="@product" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row">

        <div class="col-md-4">
            <label>Name (FA)</label>
            <InputText class="form-control" @bind-Value="product.Name_FA" />
        </div>

        <div class="col-md-4">
            <label>Name (EN)</label>
            <InputText class="form-control" @bind-Value="product.Name_EN" />
        </div>

        <div class="col-md-4">
            <label>Name (AR)</label>
            <InputText class="form-control" @bind-Value="product.Name_AR" />
        </div>

        <div class="col-md-6 mt-3">
            <label>Description (FA)</label>
            <InputTextArea class="form-control" @bind-Value="product.Description_FA" />
        </div>

        <div class="col-md-6 mt-3">
            <label>Description (EN)</label>
            <InputTextArea class="form-control" @bind-Value="product.Description_EN" />
        </div>

        <div class="col-md-4 mt-3">
            <label>Price</label>
            <InputNumber class="form-control" @bind-Value="product.Price" />
        </div>

        <div class="col-md-4 mt-3">
            <label>Stock Quantity</label>
            <InputNumber class="form-control" @bind-Value="product.StockQuantity" />
        </div>

        <div class="col-md-4 mt-3">
            <label>SKU</label>
            <InputText class="form-control" @bind-Value="product.SKU" />
        </div>

        <div class="col-md-6 mt-3">
            <label>Brand</label>
            <InputSelect class="form-control" @bind-Value="product.BrandId">
                <option value="">Select Brand</option>
                @foreach (var brand in brands)
                {
                    <option value="@brand.Id">@brand.Name</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-6 mt-3">
            <label>Category</label>
            <InputSelect class="form-control" @bind-Value="product.CategoryId">
                <option value="">Select Category</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Id">@category.Name_FA</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-6 mt-3">
            <label>Catalog URL</label>
            <InputText class="form-control" @bind-Value="product.CatalogURL" />
        </div>

        <div class="col-md-6 mt-3">
            <label>Warranty</label>
            <InputText class="form-control" @bind-Value="product.Warranty" />
        </div>

        <div class="col-md-12 mt-4">
            <button class="btn btn-success">Save Product</button>
            <button class="btn btn-secondary ms-2" @onclick="Cancel">Cancel</button>
        </div>

    </div>
</EditForm>
@code {

    private ProductDto product = new();

    private List<ProductBrandDto> brands = new();
    private List<ProductCategoryDto> categories = new();

    protected override async Task OnInitializedAsync()
    {
        brands = await Http.GetFromJsonAsync<List<ProductBrandDto>>("api/brands");
        categories = await Http.GetFromJsonAsync<List<ProductCategoryDto>>("api//GetListCateguriesProduct");
    }

    private async Task HandleSubmit()
    {
        await Http.PostAsJsonAsync("api/products", product);
        Navigation.NavigateTo("/products");
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/products");
    }
}
